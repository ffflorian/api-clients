{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "release": {
    "projects": ["packages/*", "!corona-warn-app"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "conventionalCommits": {
      "types": {
        "refactor": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "docs": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "build": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "types": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "chore": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "examples": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "test": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "style": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "ci": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "revert": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        }
      }
    },
    "version": {
      "conventionalCommits": true
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github"
      }
    },
    "git": {
      "commit": true,
      "tag": true,
      "commitMessage": "chore(release): publish [ci skip]"
    }
  }
}
